{
  "name": "planner",
  "version": "0.1.0",
  "description": "Organizador personal local en Markdown: semana por horas, hoy, metas y progreso. Sin IA, sin nube y sin dependencias.",
  "private": true,
  "type": "module",
  "bin": {
    "planner": "./bin/planner.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "start": "node bin/planner.js",
    "dev": "node --watch-path=src --watch-path=bin bin/planner.js --ejemplo --silencioso",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {},
  "license": "MIT"
}
